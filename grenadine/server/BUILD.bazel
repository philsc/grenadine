load("@crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    # Read by the tests in //grenadine/testing for the default inboxes.
    "src/inboxes.rs",
])

WEB_FILES = {
    "GRENADINE_INDEX_HTML": "//grenadine/web:static/index.html",
    "GRENADINE_STYLE_CSS": "//grenadine/web:static/style.css",
    "GRENADINE_FAVICON_SVG": "//grenadine/web:static/favicon.svg",
    "GRENADINE_WEB_JS": "//grenadine/web:grenadine_web.js",
    "GRENADINE_WEB_WASM": "//grenadine/web:grenadine_web_bg.wasm",
    "GRENADINE_XTERM_JS": "//grenadine/web:xterm.js",
    "GRENADINE_XTERM_CSS": "//grenadine/web:xterm.css",
    "GRENADINE_XTERM_FIT_JS": "//grenadine/web:addon-fit.js",
}

# The server's logic. It doesn't need the web UI's files, so it compiles
# while the UI's WebAssembly does.
rust_library(
    name = "server_lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/bin/**",
            "src/main.rs",
        ],
    ),
    crate_name = "grenadine_server",
    deps = all_crate_deps(normal = True) + ["//grenadine/core"],
)

# The server with the web UI's files embedded.
rust_binary(
    name = "server",
    srcs = ["src/main.rs"],
    compile_data = WEB_FILES.values(),
    crate_name = "grenadine",
    # rules_rust makes these absolute, which include_bytes! needs.
    rustc_env = {k: "$(execpath %s)" % v for k, v in WEB_FILES.items()},
    visibility = ["//grenadine/testing:__pkg__"],
    deps = [
        ":server_lib",
        "@crates//:anyhow",
        "@crates//:tokio",
    ],
)

rust_binary(
    name = "validate_inboxes",
    srcs = [
        "src/bin/validate_inboxes.rs",
        "src/github.rs",
        "src/inbox_search.rs",
        "src/inboxes.rs",
        "src/ratelimit.rs",
    ],
    crate_root = "src/bin/validate_inboxes.rs",
    deps = all_crate_deps(normal = True) + ["//grenadine/core"],
)

rust_test(
    name = "server_test",
    size = "small",
    crate = ":server_lib",
    data = ["//grenadine/testing:fake_devin"],
    env = {"FAKE_DEVIN": "$(rootpath //grenadine/testing:fake_devin)"},
    deps = all_crate_deps(normal_dev = True),
)
