load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

# Creates the GitHub repo that grenadine's end-to-end tests run against:
# bazel run //grenadine/testing:create_test_repo -- --other-user=NAME --clone-dir=PATH [--recreate]
py_binary(
    name = "create_test_repo",
    srcs = ["create_test_repo.py"],
)

# A fake GitHub API and git host for running the server in tests, and the
# PRs the tests load it with.
py_library(
    name = "fake_github",
    srcs = [
        "fake_github.py",
        "scenarios.py",
    ],
    data = [
        "github_schema.graphql",
        "//grenadine/server:src/inboxes.rs",
    ],
    deps = ["@grenadine_pypi//graphql_core"],
)

py_test(
    name = "fake_github_test",
    size = "small",
    srcs = ["fake_github_test.py"],
    deps = [":fake_github"],
)

# Stands in for `devin acp` in the server's and the UI's tests, playing a
# scenario file.
py_binary(
    name = "fake_devin",
    srcs = ["fake_devin.py"],
    visibility = ["//grenadine/server:__pkg__"],
)

# Loads the UI in a headless browser against a server backed by the fake
# GitHub.
py_test(
    name = "ui_test",
    size = "medium",
    srcs = ["ui_test.py"],
    data = [
        ":fake_devin",
        "//grenadine/server",
        "@chrome_deps//:lib_dir",
        "@chrome_deps//:libs",
        "@chrome_headless_shell//:chrome-headless-shell",
        "@chrome_headless_shell//:files",
    ],
    env = {
        "CHROME": "$(rootpath @chrome_headless_shell//:chrome-headless-shell)",
        "CHROME_LIB_DIR": "$(rootpath @chrome_deps//:lib_dir)",
        "FAKE_DEVIN": "$(rootpath :fake_devin)",
        "GRENADINE_SERVER": "$(rootpath //grenadine/server)",
    },
    # The shards run on remote executors at once, so the slowest one sets
    # the test's time. With 32, that's about 35s; 48 didn't lower it and
    # only added setup, since each shard sets up most of the test classes.
    shard_count = 32,
    deps = [
        ":fake_github",
        "@grenadine_pypi//playwright",
        "@grenadine_pypi//pytest_bazel",
        "@grenadine_pypi//pytest_shard",
    ],
)
