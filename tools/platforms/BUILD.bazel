# The platform BuildBuddy's remote executors provide. --config=remote
# registers it as the execution platform.
platform(
    name = "rbe",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        # BuildBuddy's ubuntu:24.04 image with build essentials, including
        # git, which the server's and the UI's tests run. Chrome's libraries
        # come from @chrome_deps. Look up a newer digest with
        #   docker buildx imagetools inspect gcr.io/flame-public/rbe-ubuntu24-04:latest
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75",
    },
    visibility = ["//visibility:public"],
)
