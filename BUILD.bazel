load("@npm//:defs.bzl", "npm_link_all_packages")
load("@rules_uv//uv:pip.bzl", "pip_compile")

exports_files(["ruff.toml"])

npm_link_all_packages(name = "node_modules")

# Format files with: bazel run //:format [-- PATH...]
# Check them with:   bazel run //:format.check
alias(
    name = "format",
    actual = "//tools/format",
)

alias(
    name = "format.check",
    actual = "//tools/format:format.check",
)

# Regenerate with: bazel run //:requirements
# Check in CI with:  bazel test //:requirements_test
pip_compile(
    name = "requirements",
    requirements_in = "requirements.in",
    requirements_txt = "requirements.txt",
    # No args= here on purpose. It *replaces* rules_uv's defaults, which are
    # --generate-hashes, --emit-index-url and --no-strip-extras; losing the
    # last of those strips the extras from the lock. Use extra_args to add a
    # flag.
    # Resolve one lock that holds for every platform, with environment markers
    # where they diverge, rather than one that describes this machine.
    universal = True,
)
