module(
    name = "grenadine",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_js", version = "3.5.1")
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")
bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_rust_wasm_bindgen", version = "0.74.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_uv", version = "0.89.2")

# aspect_rules_lint, via rules_buf, asks for rules_go 0.42.0, which uses the
# CcInfo symbol that Bazel 9 removed.
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = None)

# rules_python ships the interpreter three times over in every py_binary's
# runfiles: bin/python, bin/python3 and bin/python3.13 are all the same 110MB
# statically-linked CPython. The first patch keeps bin/python3, the one the
# toolchain points at.
#
# The interpreter's repo also symlinks its __pycache__ directories to a cache
# outside the repo, which keeps the repo out of the remote repo contents cache.
# The second patch makes them empty files instead.
single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = [
        "//third_party/rules_python:0001-Remove-superfluous-copies-of-the-runtime.patch",
        "//third_party/rules_python:0002-Use-empty-pycache-files-instead-of-symlinks.patch",
    ],
)

# These modules download tools pinned by checksum but don't say that the
# result is reproducible, so Bazel fetched them again on every fresh output
# base instead of taking them from the remote repo contents cache. The patches
# say so.
single_version_override(
    module_name = "rules_multitool",
    patch_strip = 1,
    patches = ["//third_party/rules_multitool:0001-Mark-the-downloaded-repository-reproducible.patch"],
)

single_version_override(
    module_name = "rules_nodejs",
    patch_strip = 1,
    patches = ["//third_party/rules_nodejs:0001-Mark-the-downloaded-repository-reproducible.patch"],
)

single_version_override(
    module_name = "yq.bzl",
    patch_strip = 1,
    patches = ["//third_party/yq_bzl:0001-Mark-the-downloaded-repository-reproducible.patch"],
)

# MODULE.bazel.lock only keeps the results of module extensions that aren't
# reproducible, so every fresh output base evaluated these two again: the
# crate extension materialized the host's cargo and rustc (~800MB), and the
# npm extension fetched coreutils. The patches have the lockfile keep them.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = ["//third_party/rules_rust:0001-Keep-the-crate-extension-in-the-lockfile.patch"],
)

single_version_override(
    module_name = "aspect_rules_js",
    patch_strip = 1,
    patches = ["//third_party/aspect_rules_js:0001-Keep-the-npm-extension-in-the-lockfile.patch"],
)

# Some modules register toolchains whose repos every toolchain resolution
# fetches, and whose rules depend on the host, so they can't come from the
# remote repo contents cache. Nothing here uses them, so an empty repo stands
# in for each:
# - rules_buf (via aspect_rules_lint) downloads buf (72MB) for the host.
# - rules_swift (via aspect_rules_js and rules_apple) runs the host's swiftc
#   to configure itself, which took 30s on GitHub's runners.
bazel_dep(name = "rules_buf", version = "0.5.2")
bazel_dep(name = "rules_swift", version = "3.1.2")

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

local_repository(
    name = "no_toolchains",
    path = "third_party/no_toolchains",
)

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")

override_repo(
    buf,
    rules_buf_toolchains = "no_toolchains",
)

swift_deps = use_extension("@rules_swift//swift:extensions.bzl", "non_module_deps")

override_repo(
    swift_deps,
    build_bazel_rules_swift_local_config = "no_toolchains",
)

# Opt out of the deprecated implicit __init__.py creation. Every package that
# needs one must list it explicitly in srcs/deps.
# See https://github.com/bazel-contrib/rules_python/issues/2945
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "grenadine_pypi",
    python_version = "3.13",
    requirements_lock = "//:requirements.txt",
)

# pytest-shard assigns each test to the shard its node ID hashes to, which
# leaves shards unbalanced and sometimes empty. The patch deals the tests out
# round-robin instead.
# See https://github.com/AdamGleave/pytest-shard/issues/6
pip.override(
    file = "pytest_shard-0.1.2-py3-none-any.whl",
    patch_strip = 1,
    patches = ["//third_party/pytest_shard:0001-Shard-tests-round-robin.patch"],
)
use_repo(pip, "grenadine_pypi")

# A hermetic C/C++ toolchain, which rules_rust also links with. Without it,
# rules_cc configures one from whatever compiler and linker the host has, so
# builds differ between machines.
llvm_toolchain = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchain.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchain.target(
    arch = "wasm32",
    os = "none",
)
use_repo(llvm_toolchain, "llvm_toolchains")

register_toolchains("@llvm_toolchains//:all")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # The web UI is compiled to WebAssembly.
    extra_target_triples = ["wasm32-unknown-unknown"],
    # rules_rust 0.74.0 predates 1.98.1 and has no hashes for it, so pin the
    # host's archives here. Without them the download goes unverified. Another
    # exec platform needs its own entries; get them from
    # https://static.rust-lang.org/dist/<archive>.sha256.
    sha256s = {
        "cargo-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "ea1de9f9e23107d97ee2b41a72c552f34064a593da503789218387aee59f3ba4",
        "clippy-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e167f333be24e1d5eea56ea563c7def0aa0bd613f5ce3445976c93b0288799d1",
        "llvm-tools-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "56d58ca2dfa848359ab23c872791509c6f592448d2f6c146ed530ec50ee45371",
        "rust-std-1.98.1-wasm32-unknown-unknown.tar.xz": "cf1fcf68880d8b2b90128cede7416cfb82ad3584357ce9fb668f2b6244c26e55",
        "rust-std-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "fa3ff450172a16c026944030230c5069947af93c728d9179971d44e5e0cfb561",
        "rustc-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e974f036b28565f37c0f3bd92ddefa809bee16c04f9dcf07b9ed96e05aaaf7c4",
        "rustfmt-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "b29a1addcbf2aa8f5785075605700e63cbe131b08c8334b50c09cfca8bbc51dc",
    },
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# Third-party crates come from the Cargo workspace so that cargo and
# rust-analyzer see the same dependencies as Bazel. After editing a
# Cargo.toml, run:
#   bazel run @rules_rust//tools/upstream_wrapper:cargo -- update --workspace --manifest-path=$PWD/Cargo.toml
#   CARGO_BAZEL_REPIN=1 bazel mod tidy
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    # The members too: MODULE.bazel.lock keeps the extension's result (see
    # third_party/rules_rust), and only the files listed here make Bazel
    # evaluate it again, which checks that the pins are up to date.
    manifests = [
        "//:Cargo.toml",
        "//grenadine/core:Cargo.toml",
        "//grenadine/server:Cargo.toml",
        "//grenadine/web:Cargo.toml",
    ],
    supported_platform_triples = [
        "x86_64-unknown-linux-gnu",
        "wasm32-unknown-unknown",
    ],
)

# wasm_split_macros (via leptos) reads CARGO_MANIFEST_PATH, which cargo sets
# and Bazel doesn't, to name a symbol uniquely per crate.
crate.annotation(
    crate = "wasm_split_helpers",
    rustc_env = {"CARGO_MANIFEST_PATH": "wasm_split_helpers/Cargo.toml"},
)
use_repo(crate, "crates")

# The npm packages, for now only formatters. After editing package.json, run:
#   bazel run -- @pnpm//:pnpm --dir $PWD install --lockfile-only
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    npmrc = "//:.npmrc",
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "npm")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

# The browser for the Playwright UI tests. Keep it at the chromium-headless-shell
# browserVersion in playwright-core's browsers.json for the playwright pinned in
# requirements.in:
#   https://unpkg.com/playwright-core@<version>/browsers.json
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "chrome_headless_shell",
    build_file_content = """
filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

exports_files(["chrome-headless-shell"])
""",
    sha256 = "a9da028861a0cf789ff25c2fed45f5f1aaf969ed9247835b6a7821a4f7af9d1d",
    strip_prefix = "chrome-headless-shell-linux64",
    urls = [
        "https://storage.googleapis.com/chrome-for-testing-public/153.0.8010.12/linux64/chrome-headless-shell-linux64.zip",
        "https://cdn.playwright.dev/builds/cft/153.0.8010.12/linux64/chrome-headless-shell-linux64.zip",
    ],
)

# The prebuilt wasm-bindgen CLI. rules_rust_wasm_bindgen builds it from source
# by default, which put ~8k more targets into every build's analysis, and
# fetched Chrome and chromedriver for its test runner, which nothing here
# uses. Keep the version at the wasm-bindgen crate's in Cargo.lock; the CLI
# refuses WebAssembly from any other.
http_archive(
    name = "wasm_bindgen_cli",
    build_file_content = """
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")

native_binary(
    name = "wasm_bindgen",
    src = "wasm-bindgen",
    visibility = ["//visibility:public"],
)
""",
    sha256 = "3039f38f65fe237b640cf06a140c919ca8d717ec5012146d145d3f27bb4d6b28",
    strip_prefix = "wasm-bindgen-0.2.121-x86_64-unknown-linux-musl",
    urls = ["https://github.com/wasm-bindgen/wasm-bindgen/releases/download/0.2.121/wasm-bindgen-0.2.121-x86_64-unknown-linux-musl.tar.gz"],
)

register_toolchains("//tools/wasm_bindgen:toolchain")

# Chrome loads these shared libraries from the host, but the stock images on
# remote executors don't have them.
chrome_deps = use_repo_rule("//third_party/chrome_deps:debs.bzl", "chrome_deps")

chrome_deps(
    name = "chrome_deps",
    packages = "//third_party/chrome_deps:packages.txt",
)
