module(
    name = "grenadine",
    version = "0.0.0",
)

bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "rules_rust", version = "0.74.0")

bazel_dep(name = "rules_uv", version = "0.89.2")

# rules_python ships the interpreter three times over in every py_binary's
# runfiles: bin/python, bin/python3 and bin/python3.13 are all the same 110MB
# statically-linked CPython. The patch keeps bin/python3, the one the toolchain
# points at.
single_version_override(
    module_name = "rules_python",
    patch_strip = 1,
    patches = ["//third_party/rules_python:0001-Remove-superfluous-copies-of-the-runtime.patch"],
)

# Opt out of the deprecated implicit __init__.py creation. Every package that
# needs one must list it explicitly in srcs/deps.
# See https://github.com/bazel-contrib/rules_python/issues/2945
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "grenadine_pypi",
    python_version = "3.13",
    requirements_lock = "//:requirements.txt",
)
use_repo(pip, "grenadine_pypi")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    # rules_rust 0.74.0 predates 1.98.1 and has no hashes for it, so pin the
    # host's archives here. Without them the download goes unverified. Another
    # exec platform needs its own entries; get them from
    # https://static.rust-lang.org/dist/<archive>.sha256.
    sha256s = {
        "cargo-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "ea1de9f9e23107d97ee2b41a72c552f34064a593da503789218387aee59f3ba4",
        "clippy-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e167f333be24e1d5eea56ea563c7def0aa0bd613f5ce3445976c93b0288799d1",
        "llvm-tools-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "56d58ca2dfa848359ab23c872791509c6f592448d2f6c146ed530ec50ee45371",
        "rust-std-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "fa3ff450172a16c026944030230c5069947af93c728d9179971d44e5e0cfb561",
        "rustc-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "e974f036b28565f37c0f3bd92ddefa809bee16c04f9dcf07b9ed96e05aaaf7c4",
        "rustfmt-1.98.1-x86_64-unknown-linux-gnu.tar.xz": "b29a1addcbf2aa8f5785075605700e63cbe131b08c8334b50c09cfca8bbc51dc",
    },
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")
